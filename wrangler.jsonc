{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar4christmas",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "calendar4christmas-private" }
  ],
  "observability": { "enabled": true }
}
